[Unit]
Description=KiteTerm 管理平台
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 二进制放 /usr/local/bin/kite-server,配置放 /etc/kite-server/kite-server.env(chmod 600)
EnvironmentFile=/etc/kite-server/kite-server.env
ExecStart=/usr/local/bin/kite-server
WorkingDirectory=/var/lib/kite-server
StateDirectory=kite-server
StateDirectoryMode=0700
DynamicUser=yes
Restart=on-failure
RestartSec=3s
# 加固
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
