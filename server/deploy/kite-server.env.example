# KiteTerm 管理平台 —— 生产环境变量样例
# 复制为 /etc/kite-server/kite-server.env 并 chmod 600。

# 监听地址。生产建议只监听本机,由 Nginx/Caddy 做 TLS 反代;直接暴露则改 0.0.0.0。
KITE_LISTEN=127.0.0.1:8787
# SQLite 库路径(systemd 单元的 StateDirectory 会创建 /var/lib/kite-server)
KITE_DB=/var/lib/kite-server/kite-server.db
# 管理控制台与管理 API 的密钥(必填)。生成:openssl rand -hex 32
KITE_ADMIN_KEY=
# 注册策略初值 open|invite|closed(之后以控制台设置为准)
KITE_REGISTRATION=invite
# 功能门禁总闸 on|off(默认 off:8 个产品开关不起作用,3 个安全策略照常)
KITE_FEATURE_GATING=off
# 同一 IP 每小时注册尝试上限
KITE_REGISTER_LIMIT=5

# S3 兼容存储 —— 仅作初值,在控制台「S3 存储」页保存后以数据库为准
S3_ENDPOINT=https://s3.example.com
S3_BUCKET=kite-sync
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PREFIX=
# MinIO / 自建网关 on;AWS S3 / R2 off
S3_PATH_STYLE=on
# STS 限权凭据:auto(失败回退共享凭据)| require(生产推荐)| off
KITE_STS=require

# 邮箱验证码发信(可选;不配则验证码打进服务端日志,管理员可在控制台手工标记已验证)
KITE_SMTP_HOST=
KITE_SMTP_PORT=587
KITE_SMTP_USER=
KITE_SMTP_PASS=
KITE_SMTP_FROM=
